locals {
  name = "${var.project_name}-${var.environment}"

  key_name = var.create_key_pair ? aws_key_pair.generated[0].key_name : (var.existing_key_name != "" ? var.existing_key_name : null)
}

# ---------------------------------------------------------------------------
# Network: default VPC + default subnets
# ---------------------------------------------------------------------------
data "aws_vpc" "default" {
  default = true
}

# Availability Zones that actually offer the chosen instance type
# (e.g. us-east-1e does not offer t3.*).
data "aws_ec2_instance_type_offerings" "supported" {
  location_type = "availability-zone"

  filter {
    name   = "instance-type"
    values = [var.instance_type]
  }
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }

  filter {
    name   = "default-for-az"
    values = ["true"]
  }

  filter {
    name   = "availability-zone"
    values = data.aws_ec2_instance_type_offerings.supported.locations
  }
}

# ---------------------------------------------------------------------------
# AMI: latest Amazon Linux 2023 (x86_64) via public SSM parameter
# ---------------------------------------------------------------------------
data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

# ---------------------------------------------------------------------------
# Security group
# ---------------------------------------------------------------------------
resource "aws_security_group" "app" {
  name        = "${local.name}-sg"
  description = "Hotel app: HTTP from anywhere, SSH from ssh_allowed_cidr"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH (WARNING: default 0.0.0.0/0 is open to the internet; restrict ssh_allowed_cidr)"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_allowed_cidr]
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${local.name}-sg"
  }
}

# ---------------------------------------------------------------------------
# SSH key pair (optional, generated by Terraform)
# ---------------------------------------------------------------------------
resource "tls_private_key" "ssh" {
  count     = var.create_key_pair ? 1 : 0
  algorithm = "ED25519"
}

resource "aws_key_pair" "generated" {
  count      = var.create_key_pair ? 1 : 0
  key_name   = "${local.name}-key"
  public_key = tls_private_key.ssh[0].public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  count           = var.create_key_pair ? 1 : 0
  content         = tls_private_key.ssh[0].private_key_openssh
  filename        = var.private_key_path
  file_permission = "0400"
}

# ---------------------------------------------------------------------------
# Database password (sensitive; lives in state and in the instance .env)
# ---------------------------------------------------------------------------
resource "random_password" "db" {
  length  = 24
  special = false # keeps the value safe for .env files and shell quoting
}

# ---------------------------------------------------------------------------
# EC2 instance
# ---------------------------------------------------------------------------
resource "aws_instance" "app" {
  ami                         = data.aws_ssm_parameter.al2023.value
  instance_type               = var.instance_type
  subnet_id                   = data.aws_subnets.default.ids[0]
  vpc_security_group_ids      = [aws_security_group.app.id]
  key_name                    = local.key_name
  associate_public_ip_address = true

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    repo_url        = var.repo_url
    repo_branch     = var.repo_branch
    compose_version = var.compose_version
    db_name         = var.db_name
    db_user         = var.db_user
    db_password     = random_password.db.result
    swap_size_mb    = var.swap_size_mb
  })
  user_data_replace_on_change = true

  metadata_options {
    http_endpoint = "enabled"
    http_tokens   = "required" # IMDSv2 only
  }

  root_block_device {
    volume_type           = "gp3"
    volume_size           = var.root_volume_size
    encrypted             = true
    delete_on_termination = true
  }

  tags = {
    Name = "${local.name}-app"
  }

  lifecycle {
    # The SSM parameter always points to the newest AL2023 AMI. Without this,
    # a new AMI release would replace the instance and wipe the database volume.
    ignore_changes = [ami]

    precondition {
      condition     = var.create_key_pair || var.existing_key_name != ""
      error_message = "Set create_key_pair = true or provide existing_key_name; otherwise there is no way to SSH into the instance."
    }
    precondition {
      condition     = length(data.aws_subnets.default.ids) > 0
      error_message = "No default subnet in this region is in an Availability Zone that offers the selected instance_type."
    }
  }
}

# ---------------------------------------------------------------------------
# Elastic IP
# ---------------------------------------------------------------------------
resource "aws_eip" "app" {
  domain = "vpc"

  tags = {
    Name = "${local.name}-eip"
  }
}

resource "aws_eip_association" "app" {
  instance_id   = aws_instance.app.id
  allocation_id = aws_eip.app.id
}
